# CreditFlow environment variables — placeholders only (NO real values).
# Copy to `.env` and fill locally. `.env` is gitignored — never commit real secrets.
#
# MLflow backend & artifact store (P7+): leave blank if using local ./mlruns
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Inference service (P8+)
API_HOST=0.0.0.0
API_PORT=8000
MODEL_NAME=creditflow-model
MODEL_VERSION=

# Monitoring (P11+): optional, blank by default
PROMETHEUS_PORT=9100