# CreditFlow — Environment Template
# Copy to .env and fill real values. NEVER commit .env.

# Rendering (Render.com) deployment API key
RENDER_API_KEY=

# AI provider: "openai" | "anthropic" | "cloudflare"
CREDITFLOW_LLM_PROVIDER=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Optional, manual LLM-judge evaluation only; never needed by the API runtime.
# `--judge-provider azure-openai` uses the Azure OpenAI v1 chat-completions API.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_JUDGE_DEPLOYMENT=
# Optional Cloudflare judge model override (defaults to CLOUDFLARE_MODEL/default model).
CLOUDFLARE_JUDGE_MODEL=

# Machine-job authentication (production) / legacy synthetic demo key
CREDITFLOW_API_KEY=
CREDITFLOW_API_KEY_ID=
CREDITFLOW_API_KEY_ROLE=

# Production human identity: values must come from the bank IdP owner.
CREDITFLOW_OIDC_ISSUER=
CREDITFLOW_OIDC_AUDIENCE=
CREDITFLOW_OIDC_JWKS_URL=
# JSON mapping IdP group IDs to UNDERWRITER_L1 or RISK_COMMITTEE_L2.
CREDITFLOW_OIDC_ROLE_MAP_JSON=

# Sacombank OIDC client registration (set only when the IdP flow requires it).
SACOMBANK_OIDC_CLIENT_ID=
SACOMBANK_OIDC_CLIENT_SECRET=
SACOMBANK_OIDC_ISSUER=

# Explicit local synthetic-demo options; leave unset for normal deployment.
CREDITFLOW_ENABLE_DEMO_LOGIN=
CREDITFLOW_DEMO_USERS_JSON=
# JSON identity -> role map for pilot task assignment; only used outside production.
CREDITFLOW_PILOT_STAFF_JSON=
CREDITFLOW_JWT_SECRET=
CREDITFLOW_ALLOW_ANONYMOUS_DEMO=

# Bank-approved calendar JSON: timezone, weekdays, start/end, holidays,
# sla_hours_by_kind. Absent config means tasks have no automatic due date.
CREDITFLOW_WORK_CALENDAR_JSON=
# Comma-separated bank-approved required document types (metadata presence only).
CREDITFLOW_REQUIRED_DOCUMENT_TYPES=

# Environment: "development" | "staging" | "production"
CREDITFLOW_ENV=

# CORS origins (comma-separated)
CREDITFLOW_CORS_ORIGINS=

# Self-hosted MLflow tracking stack (development-only local defaults).
# MLFLOW_DB_PASSWORD ở đây chỉ là placeholder cho stack localhost;
# giá trị thật đặt trong .env (gitignored), KHÔNG commit.
MLFLOW_TRACKING_URI=
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=

# === ADDITIONAL: Sprint 1 Production-Critical Secrets ===
# Azure Container Apps (production target)
DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# === App Config ===
STALE_THRESHOLD_DAYS=7
LOG_LEVEL=INFO
CREDITFLOW_API_URL=

# Sacombank Business Calendar (CREDITFLOW_WORK_CALENDAR_JSON)
# Timezone: Asia/Ho_Chi_Minh (UTC+7)
# Work weekdays: Mon-Fri (1-5 in Python weekday)
# Work hours: 8:00 - 17:00
# Holidays: Vietnamese public holidays 2026
# SLA hours by task kind: DOCUMENT_CHECK=24, APPROVAL=48, REVIEW=72
CREDITFLOW_WORK_CALENDAR_JSON='{"timezone":"Asia/Ho_Chi_Minh","weekdays":[1,2,3,4,5],"start":"08:00:00","end":"17:00:00","holidays":["2026-01-01","2026-01-28","2026-01-29","2026-01-30","2026-01-31","2026-02-01","2026-02-02","2026-02-03","2026-04-30","2026-05-01","2026-09-02","2026-09-03"],"sla_hours_by_kind":{"DOCUMENT_CHECK":24,"APPROVAL":48,"REVIEW":72,"EXCEPTION":24}}'

# Core Banking
CREDITFLOW_CORE_BANKING_API_URL=
CREDITFLOW_CORE_BANKING_API_KEY=
CREDITFLOW_CORE_BANKING_SANDBOX_MODE=true

# Notification
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=noreply@creditflow.local
SMTP_FROM_NAME=CreditFlow

# SMS Gateway (twilio | vnpt | log)
SMS_GATEWAY=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
VNPT_API_KEY=
VNPT_API_URL=
VNPT_SENDER_ID=

# Notification retry
NOTIFICATION_RETRY_BASE_SECONDS=60
NOTIFICATION_MAX_RETRY_ATTEMPTS=5
NOTIFICATION_RETRY_MAX_SECONDS=86400

# User revocation
CREDITFLOW_REVOKED_USERS_JSON=[]

# Bootstrap users (JSON array)
CREDITFLOW_USERS_JSON=[]

# Core banking simulation
CREDITFLOW_SANDBOX_MIN_DELAY=0.1
CREDITFLOW_SANDBOX_MAX_DELAY=1.0
CREDITFLOW_SANDBOX_SUCCESS_RATE=0.95
CREDITFLOW_SANDBOX_FAILURE_RATE=0.04
CREDITFLOW_SANDBOX_TIMEOUT_RATE=0.01
