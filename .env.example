# CreditFlow — Environment Template
# Copy to .env and fill real values. NEVER commit .env.

# Rendering (Render.com) deployment API key
RENDER_API_KEY=

# AI provider: "openai" | "anthropic" | "cloudflare"
CREDITFLOW_LLM_PROVIDER=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Service authentication
CREDITFLOW_API_KEY=
CREDITFLOW_API_KEY_ID=
CREDITFLOW_API_KEY_ROLE=

# Environment: "development" | "staging" | "production"
CREDITFLOW_ENV=

# CORS origins (comma-separated)
CREDITFLOW_CORS_ORIGINS=

# Self-hosted MLflow tracking stack (development-only local defaults).
# MLFLOW_DB_PASSWORD ở đây chỉ là placeholder cho stack localhost;
# giá trị thật đặt trong .env (gitignored), KHÔNG commit.
MLFLOW_TRACKING_URI=
MLFLOW_DB_USER=
MLFLOW_DB_PASSWORD=
MLFLOW_DB_NAME=

# === ADDITIONAL: Sprint 1 Production-Critical Secrets ===
# Azure Container Apps (production target)
DATABASE_URL=
REDIS_URL=
OPENAI_API_KEY=
QDRANT_URL=http://localhost:6333

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
PROMETHEUS_PUSHGATEWAY=http://localhost:9091

# === App Config ===
STALE_THRESHOLD_DAYS=7
LOG_LEVEL=INFO
CREDITFLOW_API_URL=https://creditflow-api.blackisland-5a3f0246.southeastasia.azurecontainerapps.io
