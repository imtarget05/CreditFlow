# CreditFlow — Environment Template
# Copy to .env and fill real values. NEVER commit .env.

# Rendering (Render.com) deployment API key
RENDER_API_KEY=

# AI provider: "openai" | "anthropic" | "cloudflare"
CREDITFLOW_LLM_PROVIDER=

# Cloudflare Workers AI
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=

# Service authentication
CREDITFLOW_API_KEY=
CREDITFLOW_API_KEY_ID=
CREDITFLOW_API_KEY_ROLE=

# Environment: "development" | "staging" | "production"
CREDITFLOW_ENV=

# CORS origins (comma-separated)
CREDITFLOW_CORS_ORIGINS=
