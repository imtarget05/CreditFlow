# CreditFlow environment variables — placeholders only (NO real values).
# Copy to `.env` and fill locally. `.env` is gitignored — never commit real secrets.
#
# MLflow backend & artifact store (P7+): leave blank if using local ./mlruns
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Inference service (P8+)
API_HOST=0.0.0.0
API_PORT=8080
MODEL_NAME=creditflow-model
MODEL_VERSION=

# MLflow (P7): local file store (default ./mlruns: experiment creditflow-risk,
# registered model creditflow-risk) or a remote tracking server, e.g.
# MLFLOW_TRACKING_URI=http://localhost:5000 with
# `mlflow server --host 0.0.0.0 --port 5000`.

# Monitoring (P11+): optional, blank by default
PROMETHEUS_PORT=9100

# GenAI explain layer (Cloudflare Workers AI, optional — template fallback offline)
CREDITFLOW_LLM_PROVIDER=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct